# 本番のサイトURL（OG画像・sitemap・canonical の絶対URL生成に使用）
# 例: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 の測定ID（未設定なら計装は無効＝トラッキングしない）
# 例: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console のサイト所有権確認トークン（meta タグ方式）
# Search Console の「HTMLタグ」確認で表示される content の値のみを設定
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Brevo（ESP）のAPIキー。読者所有・メール登録エンドポイント /api/optin が使用。
# サーバー専用（NEXT_PUBLIC を付けない＝クライアントに露出させない）。Vercel の
# 環境変数にセンシティブとして設定。ローカル検証時のみ .env.local に設定する。
BREVO_API_KEY=
